# MongoDB Atlas connection string
# Dapatkan URI ini dari MongoDB Atlas: https://cloud.mongodb.com/
# Pilih "Drivers" → Node.js → "Standard connection string" (bukan SRV)
# Format: mongodb://<user>:<pass>@<host1>:27017,<host2>:27017,<host3>:27017/?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin
MONGODB_URI=mongodb://username:password@host1.mongodb.net:27017,host2.mongodb.net:27017,host3.mongodb.net:27017/?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&appName=Cluster0

# Diperlukan untuk Node.js v26 ke atas — compatibility dengan MongoDB Atlas
NODE_OPTIONS=--openssl-legacy-provider
